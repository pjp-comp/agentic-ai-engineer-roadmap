ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Defaults to true: the examples/02-* agents run against a local, free,
# open-weight model via Ollama instead of the Claude API. No key needed
# when this is true. See examples/02-basic-agent-local-langgraph/README.md
# for setup (installing Ollama, pulling the model). Set to false (and set
# ANTHROPIC_API_KEY above) to use Claude instead — the Claude code path is
# still there in every 02-* example, this just changes the default.
USE_LOCAL_MODEL=true
LOCAL_MODEL=llama3.2:3b

# Used only by examples/02-longterm-memory-vectorstore-local-langgraph, for
# embedding facts into its local ChromaDB vector store. Needed regardless of
# USE_LOCAL_MODEL, since the Claude API has no embeddings endpoint.
# ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
