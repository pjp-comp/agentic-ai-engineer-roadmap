ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Optional configuration. Most chat examples default to local Ollama.
# Only examples implementing this switch use it; see examples/README.md.
# Stage03 hosted web search is Claude-only; stage05 RAG and stage06-12
# are Ollama-only. Stage01 and stage13 require no model.
# Set false plus your own Anthropic key only for supported hosted branches.
USE_LOCAL_MODEL=true
LOCAL_MODEL=llama3.2:3b

# Used by the examples that embed text: stage04-longterm-memory-vectorstore,
# stage05-rag-langgraph, and stage05-multimodal-rag-agent. Needed regardless
# of USE_LOCAL_MODEL, since the Claude API has no embeddings endpoint.
# ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Optional hosted model-router configuration (stage02-model-router only):
# ANTHROPIC_LARGE_MODEL=<model ID available to your account>
# Illustrative rates below must be replaced with your provider's actual $/1M.
# SMALL_INPUT_RATE=1
# SMALL_OUTPUT_RATE=5
# LARGE_INPUT_RATE=5
# LARGE_OUTPUT_RATE=25
