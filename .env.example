ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Set to true to run the examples/02-* agents against a local, free,
# open-weight model via Ollama instead of the Claude API. No key needed
# when this is true. See examples/02-basic-agent-local-langgraph/README.md
# for setup (installing Ollama, pulling the model).
USE_LOCAL_MODEL=false
LOCAL_MODEL=llama3.2:3b
