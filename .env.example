ANTHROPIC_API_KEY=sk-ant-...
TAVILY_API_KEY=tvly-...

# Defaults to true: every runnable example runs against a local, free,
# open-weight model via Ollama instead of the Claude API. No key needed
# when this is true. See examples/stage02-basic-agent-local/README.md for
# setup (installing Ollama, pulling the model). Set to false (and set
# ANTHROPIC_API_KEY above) to use Claude instead — the Claude code path is
# still wired up in the stage03-* examples, this just changes the default.
#
# Note: several examples are Ollama-only by design (the stage05 RAG ones,
# stage06 through stage12) and ignore this flag. The one Claude-only
# example is stage03-web-agent-langgraph, which depends on Claude's
# server-side web_search tool.
USE_LOCAL_MODEL=true
LOCAL_MODEL=llama3.2:3b

# Used by the examples that embed text: stage04-longterm-memory-vectorstore,
# stage05-rag-langgraph, and stage05-multimodal-rag-agent. Needed regardless
# of USE_LOCAL_MODEL, since the Claude API has no embeddings endpoint.
# ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text
